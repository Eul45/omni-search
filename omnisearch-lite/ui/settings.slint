    // Phone Sync properties
    in-out property <bool> sync-server-running: false;
    in-out property <string> sync-server-ip: "";
    in-out property <int> sync-connected-clients: 0;
    in-out property <string> sync-pairing-uri: "";
    in-out property <bool> has-pending-pairing: false;
    in-out property <string> pending-device-id: "";
    in-out property <string> pending-device-name: "";
    in-out property <image> sync-qr-image;
    in-out property <bool> has-sync-qr-image: false;

    // Transfer progress properties
    in-out property <int> transfer-count: 0;
    in-out property <string> transfer-name-1: "";
    in-out property <int> transfer-progress-1: 0;
    in-out property <string> transfer-status-1: "";
    in-out property <string> transfer-name-2: "";
    in-out property <int> transfer-progress-2: 0;
